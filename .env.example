# One canonical public origin is the source of truth. Marketing pages are served
# from `/` and the authenticated product from `/app` on this SAME origin.
NEXT_PUBLIC_SITE_URL=https://findanything.dev

# Optional compatibility overrides. Leave unset in production: each one defaults
# to NEXT_PUBLIC_SITE_URL. Set one only if that surface genuinely moves to its
# own hostname.
# NEXT_PUBLIC_APP_URL=https://findanything.dev
# NEXT_PUBLIC_API_URL=https://findanything.dev
# NEXT_PUBLIC_DOCS_URL=https://findanything.dev
# NEXT_PUBLIC_MCP_URL=https://findanything.dev

# Google Drive connector. Never commit real credentials.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Optional, and highest precedence when set. When unset, the redirect URI derives
# from NEXT_PUBLIC_SITE_URL as <origin>/api/connectors/google-drive/callback.
# Keep it set for local development:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connectors/google-drive/callback

# Google Picker (per-file selection UI). The browser API key is public by
# design; restrict it in the Cloud Console to the Google Picker API and to the
# site's domain plus https://docs.google.com/*. The project number is shown on
# the Cloud Console dashboard.
GOOGLE_PICKER_API_KEY=your_browser_api_key_restricted_to_picker
GOOGLE_PROJECT_NUMBER=your_cloud_project_number

# Required before production accounts or persistence. Generate unique secrets.
TOKEN_ENCRYPTION_KEY=generate_32_random_bytes
API_KEY_PEPPER=generate_at_least_32_random_bytes
SUPPORT_EMAIL=support@findanything.dev
PRIVACY_EMAIL=privacy@findanything.dev

# Private-beta access. Store only email hashes in D1; keep the pepper secret.
BETA_ACCESS_MODE=invited
BETA_INVITE_PEPPER=generate_at_least_32_random_bytes
BETA_ADMIN_EMAILS=

# Analytics and internal founder metrics. Keep server-side keys secret.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=phc_placeholder
INTERNAL_ADMIN_TOKEN=generate_at_least_32_random_bytes

# External managed-Queue bridge. The Queue Worker receives no D1 binding.
INDEXING_QUEUE_DISPATCH_URL=https://indexing-queue-worker.example.workers.dev/enqueue
INDEXING_QUEUE_ENABLED=false
INDEXING_QUEUE_INGRESS_SECRET=generate_at_least_32_random_bytes
INDEXING_QUEUE_SERVICE_SECRET=generate_at_least_32_random_bytes
